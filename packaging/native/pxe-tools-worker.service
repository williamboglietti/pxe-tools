[Unit]
Description=PXE Tools worker
Requires=pxe-tools-nginx.service
After=pxe-tools-nginx.service
[Service]
Type=simple
EnvironmentFile=/usr/lib/pxe-tools/native/default.env
EnvironmentFile=-/var/lib/pxe-tools-native/network.env
EnvironmentFile=-/var/lib/pxe-tools-native/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/lib/pxe-tools/native/start-worker.py
Restart=on-failure
