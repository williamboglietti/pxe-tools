# {{ ansible_managed }}
# Preseed pour le discovery boot.
# But : faire netcfg DHCP, charger les drivers SATA/NVMe via partman/early_command,
# exécuter discover.sh (collecte hardware → POST /api/discovery), puis poweroff.
# Ne PAS installer Debian.

# Localisation (évite les questions interactives)
d-i debian-installer/locale string fr_FR.UTF-8
d-i keyboard-configuration/xkb-keymap select fr
d-i debian-installer/language string fr
d-i debian-installer/country string FR

# Réseau — DHCP auto sur la première interface
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string discovery
d-i netcfg/get_domain string lan
d-i netcfg/dhcp_timeout string 90
d-i netcfg/disable_autoconfig boolean false

# Mirror Debian — utilisé par anna-install pour télécharger les udebs drivers SATA/NVMe
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

# Clock — non-interactif
d-i clock-setup/utc boolean true
d-i time/zone string Europe/Paris
d-i clock-setup/ntp boolean true

# Comptes — discovery user dummy (on n'install pas)
d-i passwd/root-login boolean false
d-i passwd/user-fullname string Discovery
d-i passwd/username string discovery
d-i passwd/user-password password discovery
d-i passwd/user-password-again password discovery
d-i user-setup/encrypt-home boolean false
d-i user-setup/allow-password-weak boolean true

# apt-setup minimal
d-i apt-setup/contrib boolean false
d-i apt-setup/non-free boolean false
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/services-select multiselect security, updates

# === Discovery boot — déclenchement du script ===
#
# preseed/early_command : ping de "boot started" — la MAC est dans BOOTIF (kernel cmdline)
# au format PXELINUX (01-aa-bb-cc-dd-ee-ff). On retire le préfixe "01-" pour matcher la DB.
d-i preseed/early_command string \
    wget -q "http://{{ pxe_ip }}/api/discovery?phase=preseed_early&mac=${BOOTIF#01-}" -O /dev/null || true

# partman/early_command : drivers SATA/NVMe chargés → /sys/block peuplé, /sys/class/net OK.
# discover.sh collecte hardware (CPU, RAM, disks, NICs, IPs, SMART), POST à /api/discovery,
# puis entre en boucle de poll /api/discovery-action (≤1h) — c'est lui qui décide
# du poweroff/reboot via l'API. Le poweroff externe ci-dessous n'est exécuté que
# si discover.sh est inaccessible (HTTP 404 ou réseau down) OU s'il exit après son poll.
#
# Hardening Spec A : on log explicitement l'échec de fetch via l'API (?phase=discover_sh_404
# ou ?phase=discover_sh_run_failed) AVANT de poweroff. Avant ce hardening, le `|| true`
# masquait silencieusement le 404 → l'admin ne voyait que "machine s'éteint, pas d'inventaire".
d-i partman/early_command string \
    MAC="$(tr ' ' '\n' < /proc/cmdline | grep '^BOOTIF=' | head -1 | cut -d= -f2 | sed 's/^01-//' | tr '-' ':')"; \
    if wget -q http://{{ pxe_ip }}/discover.sh -O /tmp/d.sh 2>/dev/null; then \
        ORCH_IP={{ pxe_ip }} sh /tmp/d.sh || wget -q "http://{{ pxe_ip }}/api/discovery?phase=discover_sh_run_failed&mac=$MAC" -O /dev/null 2>/dev/null; \
    else \
        wget -q "http://{{ pxe_ip }}/api/discovery?phase=discover_sh_404&mac=$MAC" -O /dev/null 2>/dev/null; \
    fi; \
    poweroff -f || halt -p || true
