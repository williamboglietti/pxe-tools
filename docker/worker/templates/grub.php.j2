// --- Helper checkpoint (refactor 2026-05-16) ----------------------------
// Insère un événement checkpoint pour l'action en cours sur cette machine.
// Skip silencieux si aucune action active (cas legacy : machine sans action
// parent, ou status discovered/inventorying sans flow démarré).
//
// POURQUOI inline ici plutôt qu'appel HTTP au InternalApiController : grub.php
// est un script standalone (pas d'autoloader Admin\), et on a déjà $pdo +
// $machine en scope local. Insert direct = pas de round-trip ni surface
// d'attaque supplémentaire.
//
// Ordre des codes : on prend l'action la plus récente non-terminale.
function emit_grub_checkpoint(PDO $pdo, int $machineId, string $code, string $mac): void {
    try {
        $stmt = $pdo->prepare(
            "SELECT id, type FROM actions "
          . "WHERE machine_id = ? AND status IN ('pending','running') "
          . "ORDER BY id DESC LIMIT 1"
        );
        $stmt->execute([$machineId]);
        $action = $stmt->fetch();
        $stmt->closeCursor();
        if (!$action) return;
        // Valider que le code est cohérent avec le type d'action — évite
        // de poser un grub_config_served_install sur une action wipe_only.
        // SYNC avec ActionCheckpoints::CATALOG — mettre à jour si nouveau type d'action ajouté.
        // (catalogue dupliqué inline car pas d'autoloader Admin\ dans /srv/http)
        $catalog = [
            'reinstall' => ['grub_config_served_wipe', 'grub_config_served_install'],
            'install_only' => ['grub_config_served_install'],
            'wipe_only' => ['grub_config_served_wipe'],
            'disktest' => ['grub_config_served_disktest'],
        ];
        $type = (string)$action['type'];
        if (!isset($catalog[$type]) || !in_array($code, $catalog[$type], true)) return;
        $ins = $pdo->prepare(
            'INSERT INTO machine_events (machine_id, level, message, checkpoint, action_id) '
          . 'VALUES (?, ?, ?, ?, ?)'
        );
        // MAC (demandée dans l'URL) et IP (adresse qui a réellement téléchargé cette configuration) :
        // observées ici, pas déduites d'un autre événement.
        $seen = json_encode(['mac' => $mac, 'ip' => (string)($_SERVER['REMOTE_ADDR'] ?? ''), 'src' => 'grub.php'],
            JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
        $ins->execute([$machineId, 'info', 'checkpoint:' . $code . ' ' . $seen, $code, (int)$action['id']]);
    } catch (\Throwable $e) {
        error_log('grub.php: emit_checkpoint failed: ' . $e->getMessage());
    }
}

// --- Génération ----------------------------------------------------------
$bootSession = null;
echo "set timeout=3\n";
echo "set default=0\n";
echo "set net_default_server=$orch_ip\n\n";

if ($machine === null) {
    // MAC absente DB → discovery toujours en TFTP (universel, marche partout).
    // Pas d'alternative HTTP : si la machine ne supporte pas HTTP, elle ne pourrait
    // jamais faire son discovery et donc jamais être enregistrée — œuf et poule.
    // Le boot_mode HTTP/TFTP est ensuite paramétrable par machine via l'UI pour
    // les boots récurrents (install, wipe).
    //
    // Côté DB : on crée immédiatement un stub avec status='inventorying' pour que
    // la machine apparaisse dans le dashboard "en cours d'inventaire" pendant la
    // séquence GRUB → image discovery → discover.sh. Quand discover.sh POST son
    // inventaire à /api/discovery, le PxeController bascule le status à 'discovered'.
    $bootMachineId = 0;
    if ($mac !== '' && isset($pdo)) {
        try {
            // Spec D : si l'arch a pu être déduite depuis ${grub_cpu} ($archFromBoot),
            // on la persiste dès le stub. Sinon on laisse NULL et discover.sh
            // (uname -m) la complétera au POST /api/discovery.
            if ($archFromBoot !== null) {
                $stmt = $pdo->prepare(
                    'INSERT INTO machines (mac, status, last_seen_at, boot_arch) VALUES (?, ?, ?, ?)'
                );
                $stmt->execute([$mac, 'inventorying', date('Y-m-d H:i:s'), $archFromBoot]);
                $bootMachineId = (int)$pdo->lastInsertId();
                error_log("grub.php: stub created for $mac (status=inventorying, boot_arch=$archFromBoot from grub_cpu)");
            } else {
                $stmt = $pdo->prepare(
                    'INSERT INTO machines (mac, status, last_seen_at) VALUES (?, ?, ?)'
                );
                $stmt->execute([$mac, 'inventorying', date('Y-m-d H:i:s')]);
                $bootMachineId = (int)$pdo->lastInsertId();
                error_log("grub.php: stub created for $mac (status=inventorying)");
            }
        } catch (\Throwable $e) {
            error_log("grub.php: stub insert failed for $mac: " . $e->getMessage());
        }
    }
    $bootSession = begin_boot_session($bootMachineId, $mac, 'discovery');
    echo "# Machine inconnue (MAC: '$mac') — discovery en $discoveryBootProto (setting global), stub créé en 'inventorying'\n";
    echo menuentry_discovery($orch_ip, $kernel_opts, $default_distro, $default_arch, $discoveryBootProto), "\n";
} else {
    $status = $machine['status'];
    $hostname = preg_replace('/[^a-z0-9-]/', '', strtolower($machine['hostname'] ?? 'unassigned')) ?: 'unassigned';
    // Segment de path netboot = CODENAME (résolu via le symlink /netboot/<codename>/<arch>).
    // Modèle distro-name : p.distro = nom OS ('debian') ne résout PAS le path → on prend
    // p.codename, fallback dérivé du snapshot/version_full, fallback $default_distro (codename).
    $_majorToCodename = [11 => 'bullseye', 12 => 'bookworm', 13 => 'trixie', 14 => 'forky'];
    $_cfg = json_decode($machine['install_config_json'] ?? '', true) ?: [];
    $distro = strtolower(trim((string)($machine['p_codename'] ?? ($_cfg['codename'] ?? ''))));
    if ($distro === '') {
        $_vf = (string)($_cfg['version_full'] ?? '');
        $_mj = $_vf !== '' ? (int)explode('.', $_vf)[0] : 0;
        $distro = $_majorToCodename[$_mj] ?? '';
    }
    if ($distro === '') {
        // rétrocompat : p.distro est peut-être encore un codename (snapshot legacy)
        $_pd = strtolower((string)($machine['p_distro'] ?? ''));
        $distro = in_array($_pd, $_majorToCodename, true) ? $_pd : $default_distro;
    }
    // Spec D : per-machine arch override (depuis discover.sh inventory.cpu_arch).
    // Fallback sur pxe_default_arch (env DEBIAN_ARCH) si jamais discovered.
    if (!empty($machine['boot_arch'])) {
        $default_arch = $machine['boot_arch'];
    }
    $bootProto = $machine['boot_mode'] ?? 'http';
    $rescueMode = (int)($machine['rescue_mode'] ?? 0) === 1;
    $localBootAllowed = in_array((string)($machine['local_boot_source'] ?? 'none'), ['pxe', 'manual'], true);
    $defaultMenu = $rescueMode ? 'rescue' : match ($status) {
        'testing' => 'disktest',
        'wiping' => 'wipe',
        'configured' => 'install',
        'installing', 'inventorying' => 'discovery',
        default => $localBootAllowed ? 'local' : 'discovery',
    };
    $bootSession = begin_boot_session((int)$machine['id'], $mac, $defaultMenu);

    if ($rescueMode) {
        // rescue_mode=1 : priorité absolue sur le status. La machine est volontairement
        // mise en mode récupération via l'UI ; on sert uniquement le menuentry rescue
        // jusqu'à ce que l'utilisateur sorte du mode rescue (POST /machines/{id}/rescue/exit).
        echo "# Machine $hostname en mode rescue → boot Debian d-i en récupération\n";
        echo menuentry_rescue($orch_ip, $kernel_opts, $default_distro, $default_arch, $bootProto), "\n";
    } elseif ($status === 'testing') {
        // Job de tests de disque en cours → sert le menuentry disktest qui charge
        // disktest-preseed.cfg → disktest.sh télécharge smartctl/badblocks et exécute.
        echo "# Machine $hostname en cours de tests disque → boot disktest-preseed (proto=$bootProto)\n";
        echo menuentry_disktest($orch_ip, $kernel_opts, $default_distro, $default_arch, $bootProto), "\n";
        if (isset($pdo)) emit_grub_checkpoint($pdo, (int)$machine['id'], 'grub_config_served_disktest', $mac);
    } elseif ($status === 'wiping') {
        echo "# Machine $hostname en cours de wipe → boot wipe-preseed (proto=$bootProto)\n";
        echo menuentry_wipe($orch_ip, $kernel_opts, $default_distro, $default_arch, $bootProto), "\n";
        if (isset($pdo)) emit_grub_checkpoint($pdo, (int)$machine['id'], 'grub_config_served_wipe', $mac);
    } elseif ($status === 'configured') {
        echo "# Machine $hostname configurée → install auto (proto=$bootProto)\n";
        echo menuentry_install($orch_ip, $kernel_opts, $distro, $default_arch, $hostname, $mac, $bootProto), "\n";
        if (isset($pdo)) emit_grub_checkpoint($pdo, (int)$machine['id'], 'grub_config_served_install', $mac);
    } elseif ($defaultMenu === 'local') {
        // Installation PXE réussie ou choix explicite de l'administrateur.
        echo "# Machine $hostname → boot local autorisé ({$machine['local_boot_source']})\n";
        echo menuentry_local($orch_ip), "\n";
        echo "\n# Forcer la réinstall (override) :\n";
        if ($distro) {
            echo menuentry_install($orch_ip, $kernel_opts, $distro, $default_arch, $hostname, $mac, $bootProto), "\n";
        }
    } elseif (in_array($status, ['inventorying', 'unknown'], true)) {
        // 'inventorying' : stub créé par un précédent appel grub.php, en cours
        //   d'inventaire → re-sert le menuentry discovery pour terminer le cycle.
        // 'unknown' (rang 0) : machine réinitialisée via le force-statut admin →
        //   re-discovery au prochain boot PXE. Sans ce cas, 'unknown' tombait dans
        //   le `else` générique dont le default=0 chaînait sur grub.cfg → install
        //   AUTO non sollicitée (qui échouait sur preseed.php sans mac). JAMAIS ça.
        echo "# Machine ($status, mac=$mac) → (re-)boot ramdisk discovery (proto=$discoveryBootProto)\n";
        echo menuentry_discovery($orch_ip, $kernel_opts, $default_distro, $default_arch, $discoveryBootProto), "\n";
    } elseif (in_array($status, ['discovered', 'tested', 'failed', 'wiped'], true)) {
        // Machine inventoriée SANS flow actif (découverte sans preset, ou
        // revenue d'un test de disques en tested/failed). NE PAS émettre un
        // menuentry `reboot` sec ici : avec `set default=0` + `set timeout=3`,
        // GRUB l'exécute automatiquement → re-PXE → grub.php → même statut →
        // reboot → boucle GRUB infinie qui ne redescend jamais dans le ramdisk.
        // On re-boote le ramdisk discovery (idem 'inventorying') : discover.sh
        // re-POST l'inventaire (→ /api/discovery repose awaiting_action_until à
        // NOW+1h) puis poll /api/discovery-action (wait → banner d'attente ;
        // reboot/poweroff sur action admin). La machine reste donc vivante en
        // poll au lieu de boucler, et réagit à une assignation de preset en ≤5s.
        // tested/failed/wiped surtout : avant 2026-06-10 ils tombaient dans le
        // fallback boot local — une machine rallumée après un test de disques
        // tentait de démarrer son OS (souvent inexistant) au lieu de revenir
        // à l'écran d'attente. Le pendant BIOS (render-per-mac-pxelinux.sh)
        // les route déjà vers discovery via son case default.
        echo "# Machine $hostname ($status, sans flow actif) → re-boot ramdisk discovery (poll d'attente, re-timeout 1h)\n";
        echo menuentry_discovery($orch_ip, $kernel_opts, $default_distro, $default_arch, $discoveryBootProto), "\n";
    } else {
        // Statut transitoire ou futur : discovery reste le repli sûr tant
        // qu'une installation terminée n'est pas attestée dans la DB.
        echo "# Machine en status='$status' — discovery par défaut\n";
        echo menuentry_discovery($orch_ip, $kernel_opts, $default_distro, $default_arch, $discoveryBootProto), "\n";
    }
}

// Le boot local n'est proposé que si local_boot_source l'autorise plus haut.
// Toutes les autres machines ont une entrée Discovery ou opération dédiée
// en premier ; le menu générique reste accessible manuellement.
echo "menuentry 'Autres options de démarrage' {\n";
echo "    " . boot_signal($orch_ip, 'other') . "\n";
echo "    configfile (tftp,$orch_ip)/grub/grub.cfg\n";
echo "}\n";
