<?php
// {{ ansible_managed }}
// Générateur preseed Debian dynamique — lit DB SQLite + install_config_json par machine.

declare(strict_types=1);
header('Content-Type: text/plain; charset=utf-8');

require_once rtrim(getenv('PXE_APP_DIR') ?: '/app', '/') . '/src/Db.php';
try {
    $db_path = \Admin\Db::sqliteRuntimePath();
} catch (\Throwable $error) {
    http_response_code(503);
    exit("# ERREUR : base SQLite indisponible\n");
}
$tpl_file  = '{{ pxe_data_dir }}/preseed-base.cfg';
$data_file = '{{ pxe_data_dir }}/data.json';

if (!is_readable($db_path) || !is_readable($tpl_file)) {
    http_response_code(500);
    echo "# ERREUR : DB ou preseed-base.cfg introuvable\n";
    exit;
}

$data = is_readable($data_file) ? (json_decode(file_get_contents($data_file), true) ?: []) : [];
$tpl = file_get_contents($tpl_file);

// --- Lookup machine ------------------------------------------------------
function normalize_mac(string $raw): string {
    $raw = strtolower(trim($raw));
    $raw = preg_replace('/^01[-:]/', '', $raw);
    $hex = preg_replace('/[^a-f0-9]/', '', $raw);
    return strlen($hex) === 12 ? implode(':', str_split($hex, 2)) : '';
}
$mac = normalize_mac($_GET['mac'] ?? '');

$pdo = new PDO('sqlite:' . $db_path);
$pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
$pdo->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);

// --- SEC F-02 : filtre de provenance subnet PXE --------------------------
// preseed.php est servi en clair sur :80 sans auth nginx et émet des secrets
// (hash root, hash admin, action_token Bearer du late_command). La MAC n'est
// pas secrète → ce filtre réseau est la SEULE barrière, identique à /wipe.sh
// (PxeController::ipInPxeSubnet). Un hôte hors pxe_subnet reçoit 403 AVANT
// toute émission. Fonction dupliquée volontairement (PHP standalone, pas
// d'autoload) — même pattern que le « mini-clone » assumé dans PxeController.
function pxe_valid_cidr(string $cidr): bool {
    $parts = explode('/', $cidr, 2);
    if (count($parts) !== 2) return false;
    if (!preg_match('/^(?:0|[1-9]|[12][0-9]|3[0-2])$/D', $parts[1])) return false;
    return filter_var($parts[0], FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false;
}
function pxe_ip_in_cidr(string $ip, string $cidr): bool {
    if (!filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) || !pxe_valid_cidr($cidr)) return false;
    $parts = explode('/', $cidr, 2);
    $prefix = (int)$parts[1];
    $mask    = $prefix === 0 ? 0 : (-1 << (32 - $prefix)) & 0xFFFFFFFF;
    $ipLong  = ip2long($ip);
    $netLong = ip2long($parts[0]);
    if ($ipLong === false || $netLong === false) return false;
    return ($ipLong & $mask) === ($netLong & $mask);
}
// Le sous-réseau doit être fourni explicitement par l'administrateur.
$pxe_subnet = '';
try {
    $st = $pdo->query("SELECT value FROM settings WHERE key = 'pxe_subnet'");
    $r  = $st ? $st->fetch() : false;
    if ($r && !empty($r['value'])) $pxe_subnet = (string)$r['value'];
} catch (\Throwable $e) {
    // La configuration manquante ou illisible est refusée ci-dessous.
}
if (!pxe_valid_cidr($pxe_subnet)) {
    http_response_code(503);
    echo "# ERREUR : sous-réseau PXE non configuré ou invalide\n";
    exit;
}
if (!pxe_ip_in_cidr((string)($_SERVER['REMOTE_ADDR'] ?? ''), $pxe_subnet)) {
    http_response_code(403);
    echo "# ERREUR : accès refusé (hôte hors subnet PXE)\n";
    exit;
}

if ($mac === '') {
    http_response_code(400);
    echo "# ERREUR : MAC manquante (?mac=...)\n";
    exit;
}

$stmt = $pdo->prepare('SELECT * FROM machines WHERE mac = ?');
$stmt->execute([$mac]);
$machine = $stmt->fetch();

if (!$machine) {
    http_response_code(404);
    echo "# ERREUR : machine introuvable pour MAC $mac\n";
    exit;
}
if (empty($machine['install_config_json'])) {
    http_response_code(404);
    echo "# ERREUR : machine $mac sans config d'install (passer par /machines/{id}/install d'abord)\n";
    exit;
}
$config = json_decode($machine['install_config_json'], true);
if (!is_array($config)) {
    http_response_code(500);
    echo "# ERREUR : install_config_json corrompu pour MAC $mac\n";
    exit;
}
$row = array_merge($machine, $config);

// --- Refactor checkpoints 2026-05-16 ------------------------------------
// Résout l'action en cours pour cette machine pour :
//   1. Émettre le checkpoint 'preseed_loaded_install' au moment où le preseed
//      est servi à l'installateur Debian (cf. ActionCheckpoints CATALOG).
//   2. Injecter token + action_id dans le late_command (wgets checkpoints
//      partitioning_started (early_command) / late_command_started +
//      install postboot.sh + pxe-postboot.service via
//      /pxe/postboot/{action_id}/...).
//
// Skip silencieux si pas d'action active (cas legacy : machine en 'configured'
// sans Action parent — created avant Worker_CTRL ou flow manuel). Les wgets
// sont omis du late_command ; le preseed reste fonctionnel.
$action_id    = null;
$action_token = null;
$action_type  = null;
try {
    $stmt = $pdo->prepare(
        "SELECT id, token, type FROM actions "
      . "WHERE machine_id = ? AND status IN ('pending','running') "
      . "ORDER BY id DESC LIMIT 1"
    );
    $stmt->execute([(int)$machine['id']]);
    $act = $stmt->fetch();
    if ($act) {
        $action_id    = (int)$act['id'];
        $action_token = (string)$act['token'];
        $action_type  = (string)$act['type'];
        // Checkpoint preseed_loaded_install — valide pour reinstall + install_only.
        $valid_for_load = ['reinstall', 'install_only'];
        if (in_array($action_type, $valid_for_load, true)) {
            try {
                $ins = $pdo->prepare(
                    'INSERT INTO machine_events (machine_id, level, message, checkpoint, action_id) '
                  . 'VALUES (?, ?, ?, ?, ?)'
                );
                $ins->execute([
                    (int)$machine['id'],
                    'info',
                    'checkpoint:preseed_loaded_install',
                    'preseed_loaded_install',
                    $action_id,
                ]);
            } catch (\Throwable $e) {
                error_log('preseed.php: insert preseed_loaded_install failed: ' . $e->getMessage());
            }
        }
    }
} catch (\Throwable $e) {
    error_log('preseed.php: action lookup failed: ' . $e->getMessage());
}

// --- Construction des blocks dynamiques ----------------------------------

// Hostname : si machines.hostname est NULL/vide, on N'ÉMET PAS les directives
// netcfg/get_hostname et netcfg/hostname → d-i prend la valeur DHCP Option 12
// (cas "le DHCP attribue le nom" du wizard preset). Sinon valeur normalisée.
$hostnameRaw = $row['hostname'] ?? null;
$hostname    = ($hostnameRaw !== null && trim((string)$hostnameRaw) !== '')
    ? (preg_replace('/[^a-z0-9-]/', '', strtolower((string)$hostnameRaw)) ?: null)
    : null;
$domain = preg_replace('/[^a-z0-9.-]/', '', strtolower((string)($row['domain'] ?? '')));
// --- Résolution du CODENAME apt-suite (modèle distro-name) ----------------
// $distro alimente {{ '{{DISTRO_CODENAME}}' }} (mirror/suite apt) → DOIT être un
// codename ('trixie'), JAMAIS un nom d'OS ('debian'). Chaîne de fallback :
//   1. codename du snapshot (modèle distro-name nominal)
//   2. dérivé de version_full (snapshot moderne sans codename)
//   3. rétrocompat : distro EST un codename (snapshots legacy pré-refonte)
//   4. data.default_distro (codename global) ; ultime 'trixie'.
// (table inline : pas d'autoloader dans /srv/http, cf. default_advanced_config)
$_majorToCodename = [11 => 'bullseye', 12 => 'bookworm', 13 => 'trixie', 14 => 'forky'];
$_knownCodenames  = array_values($_majorToCodename);
$_rawDistro   = isset($row['distro']) ? strtolower(trim((string)$row['distro'])) : '';
$_rawCodename = isset($row['codename']) ? strtolower(trim((string)$row['codename'])) : '';
$_versionFull = (string)($config['version_full'] ?? $row['version_full'] ?? '');
$_vfMajor     = $_versionFull !== '' ? (int)explode('.', $_versionFull)[0] : 0;
if ($_rawCodename !== '') {
    $distro = $_rawCodename;
} elseif ($_vfMajor > 0 && isset($_majorToCodename[$_vfMajor])) {
    $distro = $_majorToCodename[$_vfMajor];
} elseif (in_array($_rawDistro, $_knownCodenames, true)) {
    $distro = $_rawDistro;
} else {
    $distro = $data['default_distro'] ?? 'trixie';
}

// Ne transmettre un nom ou un domaine que s'il a été renseigné.
$hostname_lines = [];
if ($hostname !== null) {
    $hostname_lines[] = "d-i netcfg/get_hostname string " . safe_preseed_scalar($hostname);
}
if ($domain !== '') {
    $hostname_lines[] = "d-i netcfg/get_domain string " . safe_preseed_scalar($domain);
}
if ($hostname !== null) {
    $hostname_lines[] = "d-i netcfg/hostname string " . safe_preseed_scalar($hostname);
}
$hostname_block = implode("\n", $hostname_lines);

// Snapshot install : install_config_json contient déjà 'advanced' (objet, structuré).
// Fallback : si snapshot legacy sans advanced, on retombe sur la colonne
// presets.advanced_config_json (string JSON), elle-même fallback aux defaults.
// On passe par parse_advanced_config (round-trip JSON) dans les 2 cas pour garantir
// le merge profond NIVEAU 1 — array_replace_recursive fusionnerait les listes
// (ex. tasksel: ['custom'] + defaults['ssh-server','standard'] = ['custom','standard']
// au lieu de ['custom']).
$adv = is_array($config['advanced'] ?? null)
    ? parse_advanced_config(json_encode($config['advanced']))
    : parse_advanced_config($row['advanced_config_json'] ?? null);
$root_login_mode = (($config['root_login_mode'] ?? $row['root_login_mode'] ?? 'enabled') === 'disabled')
    ? 'disabled' : 'enabled';
$root_hash_for_preseed = (string)($row['root_password_hash'] ?? '');
$effective_root_mode = ($root_hash_for_preseed === '') ? 'disabled' : $root_login_mode;
$admin_user_fullname = trim((string)($config['admin_user_fullname'] ?? $row['admin_user_fullname'] ?? ''));
$accountsPlaceholder = '{{ '{{ACCOUNTS_BLOCK}}' }}';
$hasAccountsBlock = (bool)preg_match('~^[\t ]*' . preg_quote($accountsPlaceholder, '~') . '[\t ]*(?:#.*)?$~m', $tpl);

// Les anciens templates personnalisés peuvent coder les comptes en dur.
// Ne pas les réécrire silencieusement : refuser tout contenu qui pourrait
// contredire le verrouillage décidé pour cette machine, avant émission.
if ($effective_root_mode === 'disabled') {
    preg_match_all('~^[\t ]*[^\s#]+[\t ]+passwd/root-login\b([^\r\n]*)$~mi', $tpl, $rootLoginDirectives);
    preg_match_all('~^[\t ]*[^\s#]+[\t ]+(passwd/root-password(?:-crypted|-again)?)\b([^\r\n]*)$~mi', $tpl, $rootPasswordDirectives, PREG_SET_ORDER);
    $safe = $hasAccountsBlock || count($rootLoginDirectives[0]) > 0;
    foreach ($rootLoginDirectives[1] as $directive) {
        if (!preg_match('~^[\t ]+boolean[\t ]+false[\t ]*(?:#.*)?$~i', $directive)) $safe = false;
    }
    foreach ($rootPasswordDirectives as $directive) {
        if (strtolower($directive[1]) !== 'passwd/root-password-crypted'
            || !preg_match('~^[\t ]+password[\t ]+![\t ]*(?:#.*)?$~i', $directive[2])) $safe = false;
    }
    if (!$safe) {
        http_response_code(422);
        echo "# ERREUR : template preseed incompatible avec root verrouillé ; utiliser le bloc comptes dynamique ou des directives root désactivées.\n";
        exit;
    }
} else {
    // Un template ancien doit utiliser le hash de cette machine ; une valeur
    // statique masquerait le choix de l'opérateur et pourrait être partagée.
    preg_match_all('~^[\t ]*[^\s#]+[\t ]+passwd/root-login\b([^\r\n]*)$~mi', $tpl, $rootLoginDirectives);
    preg_match_all('~^[\t ]*[^\s#]+[\t ]+(passwd/root-password(?:-crypted|-again)?)\b([^\r\n]*)$~mi', $tpl, $rootPasswordDirectives, PREG_SET_ORDER);
    $safe = $hasAccountsBlock || count($rootPasswordDirectives) > 0;
    foreach ($rootLoginDirectives[1] as $directive) {
        if (!preg_match('~^[\t ]+boolean[\t ]+true[\t ]*(?:#.*)?$~i', $directive)) $safe = false;
    }
    foreach ($rootPasswordDirectives as $directive) {
        $parts = preg_split('/[\t ]+/', trim($directive[2]), 2);
        if (strtolower($directive[1]) !== 'passwd/root-password-crypted'
            || count($parts) !== 2 || strtolower($parts[0]) !== 'password'
            || $parts[1] !== '{{ '{{ROOT_PASSWORD_HASH}}' }}') $safe = false;
    }
    if (!$safe) {
        http_response_code(422);
        echo "# ERREUR : directives root du template preseed incompatibles avec la configuration de la machine.\n";
        exit;
    }
}

// --- Helpers preset (inlinés : pas d'autoloader dans /srv/http) ----------
function cidr_to_netmask(int $cidr): string {
    $cidr = max(1, min(32, $cidr));
    $long = $cidr === 0 ? 0 : (-1 << (32 - $cidr)) & 0xFFFFFFFF;
    return long2ip($long);
}
function parse_dns(mixed $raw): array {
    if (is_array($raw)) {
        return array_values(array_filter(array_map('trim', $raw), fn($x) => $x !== ''));
    }
    if ($raw === null || trim((string)$raw) === '') return [];
    $decoded = json_decode((string)$raw, true);
    if (is_array($decoded)) {
        return array_values(array_filter(array_map('trim', $decoded), fn($x) => $x !== ''));
    }
    $parts = preg_split('/[\s,]+/', (string)$raw);
    return array_values(array_filter(array_map('trim', $parts), fn($x) => $x !== ''));
}

