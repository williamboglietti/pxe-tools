PXE_APP_DIR=/usr/lib/pxe-tools/app
PXE_TOOLS_DATA_DIR=/var/lib/pxe-tools
PXE_DB_PATH=/var/lib/pxe-tools/pxe-tools.sqlite
HTTP_ROOT=/var/lib/pxe-tools/http
TFTP_ROOT=/var/lib/pxe-tools/tftp
MOK_DIR=/etc/pxe-tools/mok
TLS_DIR=/var/lib/pxe-tools/tls
BOOTSTRAP_SCRIPTS_DIR=/opt/pxe-tools/scripts
BOOTSTRAP_TEMPLATES_DIR=/opt/pxe-tools/templates
PXE_SERVICE_MANAGER=systemd
PXE_HTTP_READY_FILE=/run/pxe-tools-pxe-http/ready
PXE_DNSMASQ_CONFIG=/var/lib/pxe-tools-native/rendered/dnsmasq.conf
PXE_DNSMASQ_LOG=/var/log/pxe-tools/dnsmasq.log
PXE_NGINX_CONFIG=/usr/lib/pxe-tools/native/nginx.conf
PXE_NGINX_CONF_DIR=/run/pxe-tools-nginx/conf.d
PXE_NGINX_TEMPLATE_DIR=/opt/pxe-tools/nginx
DEBIAN_CD_KEYRING=/usr/lib/pxe-tools/keyrings/pxe-debian-cd.gpg
UBUNTU_CD_KEYRING=/usr/lib/pxe-tools/keyrings/pxe-ubuntu-cd.gpg
ANSIBLE_WORKDIR=/var/lib/pxe-tools-ansible/workspace
PXE_ANSIBLE_HOME=/var/lib/pxe-tools-ansible/home
WORKER_POLL_S=5
