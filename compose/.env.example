# Copiez ce fichier vers .env puis choisissez une image locale construite
# pour cette instance. Aucun paquet distant n’est sélectionné par défaut.
PXE_TOOLS_IMAGE=
PXE_TOOLS_PULL_POLICY=never

# Ports du portail d’administration. Le service PXE HTTP utilise le port 80.
ADMIN_PORT=8443
ADMIN_HTTP_PORT=8080

# Authentification locale ; en mode proxy, renseigner explicitement les CIDR
# des seuls proxys de confiance dans AUTHENTIK_TRUSTED_PROXY_CIDRS.
AUTH_MODE=local
AUTHENTIK_TRUSTED_PROXY_CIDRS=

# Paramètres techniques facultatifs.
DEBIAN_DEFAULT_VERSION=trixie
DEBIAN_ARCH=amd64
BIOS_BOOTLOADER=lpxelinux.0
UEFI_BOOTLOADER=grubnetx64.efi
UEFI_ENABLED=true
TLS_CN=pxe-tools.local
WORKER_POLL_S=5

# Facultatif : chemin de la clé Git DANS le conteneur, si un fichier est monté
# explicitement. Le worker exige aussi des clés d’hôtes SSH préalablement vérifiées.
PXE_GIT_SSH_KEY=

# L’interface, l’adresse du serveur, le sous-réseau et le proxy DHCP sont
# choisis dans l’assistant. Le module facultatif Ansible ne fait pas partie
# de cette version ; les paramètres associés ne l’installent pas.
